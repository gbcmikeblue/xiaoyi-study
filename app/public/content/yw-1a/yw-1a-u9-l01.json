  "volumeId": "yw-1a",
  "title": "拼音总复习",
  "objectives": ["能分清声母、韵母、整体认读音节", "能读准易混的声母与韵母"],
  "blocks": [
    {
      "type": "text",
      "title": "三类拼音",
      "content": "声母 23 个（b p m f …），韵母 24 个（a o e i u ü …），整体认读音节 16 个（zhi chi shi ri …）。整体认读音节不用拼，直接读出来。"
    },
    {
      "type": "text",
      "title": "容易混的几组",
      "content": "b 和 d、p 和 q 方向相反；z c s 是平舌，zh ch sh 是翘舌；前鼻韵母 an en in 收在 n，后鼻韵母 ang eng ing 收在 ng。"
    }
  ],
  "exercises": [
    {
      "id": "yw-1a-u9-l01-ex1",
      "type": "single",
      "stem": "下面哪个是整体认读音节？",
      "options": [
        { "id": "a", "label": "zhi" },
        { "id": "b", "label": "zh" },
        { "id": "c", "label": "zhi and zh 都是" }
      ],
      "answer": ["a"],
      "explanation": "zh 是声母，zhi 是整体认读音节。"
    },
    {
      "id": "yw-1a-u9-l01-ex2",
      "type": "single",
      "stem": "“z”和“zh”的区别是什么？",
      "options": [
        { "id": "a", "label": "z 平舌，zh 翘舌" },
        { "id": "b", "label": "z 翘舌，zh 平舌" },
        { "id": "c", "label": "没有区别" }
      ],
      "answer": ["a"],
      "explanation": "z c s 舌尖平放，zh ch sh 舌尖翘起。"
    },
    {
      "id": "yw-1a-u9-l01-ex3",
      "type": "multi",
      "stem": "下面哪些是前鼻韵母？",
      "options": [
        { "id": "a", "label": "an" },
        { "id": "b", "label": "en" },
        { "id": "c", "label": "ang" },
        { "id": "d", "label": "in" }
      ],
      "answer": ["a", "b", "d"],
      "explanation": "an、en、in 收在 n；ang 收在 ng，是后鼻韵母。"
    }
  ]
}
