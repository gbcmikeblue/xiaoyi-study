      "options": [
        {
          "id": "a",
          "label": "i"
        },
        {
          "id": "b",
          "label": "u"
        },
        {
          "id": "c",
          "label": "ü"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "牙齿对齐，发“衣”的音，就是 i。"
