  "volumeId": "sx-1b",
  "title": "设计教室装饰图",
  "objectives": ["能用基本图形组合出图案", "知道对称的图案更好看"],
  "blocks": [
    {
      "type": "text",
      "title": "用图形拼图案",
      "content": "一个三角形、一个正方形、一个圆，摆来摆去就能拼出小花、房子、小动物。先想好要拼什么，再挑图形。"
    },
    {
      "type": "text",
      "title": "对称更整齐",
      "content": "左右两边一样的图案叫对称。照镜子时看到的样子，就是对称的样子。装饰图做成对称的，看起来更整齐。"
    }
  ],
  "exercises": [
    {
      "id": "sx-1b-u7-l01-ex1",
      "type": "single",
      "stem": "用图形拼图案，第一步应该做什么？",
      "options": [
        { "id": "a", "label": "想好要拼什么" },
        { "id": "b", "label": "先把所有图形摆出来" },
        { "id": "c", "label": "先涂色" }
      ],
      "answer": ["a"],
      "explanation": "先定目标，再挑需要的图形，不会白费功夫。"
    },
    {
      "id": "sx-1b-u7-l01-ex2",
      "type": "single",
      "stem": "左右两边完全一样的图案叫什么？",
      "options": [
        { "id": "a", "label": "对称" },
        { "id": "b", "label": "重复" },
        { "id": "c", "label": "随机" }
      ],
      "answer": ["a"],
      "explanation": "像照镜子一样两边一样，就是对称。"
    },
    {
      "id": "sx-1b-u7-l01-ex3",
      "type": "multi",
      "stem": "下面哪些是基本图形？",
      "options": [
        { "id": "a", "label": "三角形" },
        { "id": "b", "label": "正方形" },
        { "id": "c", "label": "圆" },
        { "id": "d", "label": "小花" }
      ],
      "answer": ["a", "b", "c"],
      "explanation": "小花是用基本图形拼出来的，不是基本图形。"
    }
  ]
}
