      "stem": "20 + 30 = ?",
      "options": [
        { "id": "a", "label": "50" },
        { "id": "b", "label": "5" },
        { "id": "c", "label": "23" }
      ],
      "answer": ["a"],
      "explanation": "2 个十加 3 个十是 5 个十，也就是 50。"
    },
