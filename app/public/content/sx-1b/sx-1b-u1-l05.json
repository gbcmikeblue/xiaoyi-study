    {
      "type": "text",
      "title": "8 差 2 到 10",
      "content": "算 8 + 5：从 5 里拿出 2 给 8，凑成 10；5 被拿走 2 还剩 3。10 + 3 = 13。所以 8 + 5 = 13。"
    },
    {
      "type": "text",
      "title": "见 8 想 2，见 7 想 3",
      "content": "8 离 10 差 2，7 差 3，6 差 4。记住这个，凑十就快了。"
    }
  ],
  "exercises": [
    {
      "id": "sx-1b-u1-l05-ex1",
      "type": "single",
      "stem": "8 + 5 = ?",
      "options": [
        {
          "id": "a",
          "label": "12"
        },
        {
          "id": "b",
          "label": "13"
        },
        {
          "id": "c",
          "label": "14"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "5 分成 2 和 3，8 + 2 = 10，10 + 3 = 13。"
    },
    {
      "id": "sx-1b-u1-l05-ex2",
