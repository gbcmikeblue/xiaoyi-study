  "title": "开心农场",
  "objectives": [
    "会用凑十法算 9 加几",
    "知道先把 9 凑成 10 再加剩下的"
  ],
  "blocks": [
    {
      "type": "image",
      "src": "/content/sx-1b/img/sx-1b-u1-l03.webp",
      "alt": "开心农场的插图"
    },
    {
      "type": "text",
      "title": "开心农场",
      "content": "算 9 + 5：从 5 里拿出 1 给 9，9 就凑成 10；5 被拿走 1 还剩 4。10 + 4 = 14。所以 9 + 5 = 14。"
    },
    {
      "type": "text",
      "title": "开心农场",
      "content": "9 离 10 差 1，所以见到 9，就从另一个数里拿出 1 来凑十。8 就拿出 2，7 就拿出 3。"
    }
  ],
  "exercises": [
    {
      "id": "sx-1b-u1-l03-ex1",
      "type": "single",
      "stem": "9 + 3 = ?",
      "options": [
        {
          "id": "a",
          "label": "11"
        },
        {
          "id": "b",
          "label": "12"
        },
        {
          "id": "c",
          "label": "13"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "3 分成 1 和 2，9 + 1 = 10，10 + 2 = 12。"
    },
    {
      "id": "sx-1b-u1-l03-ex2",
