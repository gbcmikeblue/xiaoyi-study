      "stem": "算 9 + 5 时，先把 5 分成哪两个数？",
      "options": [
        {
          "id": "a",
          "label": "1 和 4"
        },
        {
          "id": "b",
          "label": "2 和 3"
        },
        {
          "id": "c",
          "label": "5 和 0"
        }
      ],
      "answer": [
