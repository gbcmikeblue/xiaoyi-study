  "objectives": ["熟练计算 20 以内退位减法", "能选择合适的算法"],
  "blocks": [
    {
      "type": "text",
      "title": "两种算法都行",
      "content": "算 13 - 9：破十法 10 - 9 = 1、1 + 3 = 4；平十法 13 - 3 = 10、10 - 6 = 4。结果相同，选顺手的。"
    },
    {
      "type": "text",
      "title": "检查的办法",
      "content": "算完可以用加法验算：4 + 9 = 13，说明 13 - 9 = 4 算对了。"
    }
  ],
  "exercises": [
