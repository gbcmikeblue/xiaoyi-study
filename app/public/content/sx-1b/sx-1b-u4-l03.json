      "stem": "8 捆小棒是多少根？",
      "options": [
        { "id": "a", "label": "80" },
        { "id": "b", "label": "8" },
        { "id": "c", "label": "18" }
      ],
      "answer": ["a"],
      "explanation": "一捆 10 根，8 捆就是 80 根。"
    }
