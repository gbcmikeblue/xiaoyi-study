          "label": "45"
        },
        {
          "id": "b",
          "label": "54"
        },
        {
          "id": "c",
          "label": "一样大"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "十位上 5 比 4 大，所以 54 大。"
    },
