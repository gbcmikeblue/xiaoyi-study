          "label": "15"
        },
        {
          "id": "b",
          "label": "14"
        },
        {
          "id": "c",
          "label": "16"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "6 分成 1 和 5，9 + 1 = 10，10 + 5 = 15。"
