      "type": "single",
      "stem": "七巧板里最多的是哪种图形？",
      "options": [
        {
          "id": "a",
          "label": "三角形"
        },
        {
          "id": "b",
          "label": "正方形"
        },
        {
          "id": "c",
          "label": "圆"
        }
      ],
      "answer": [
        "a"
      ],
