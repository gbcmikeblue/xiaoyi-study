      "type": "single",
      "stem": "七巧板一共有几块？",
      "options": [
        {
          "id": "a",
          "label": "7 块"
        },
        {
          "id": "b",
          "label": "5 块"
        },
        {
          "id": "c",
          "label": "10 块"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "七巧板顾名思义，就是 7 块。"
    },
    {
