  "exercises": [
    {
      "id": "sx-1b-u2-l01-ex1",
      "type": "single",
      "stem": "4 条边一样长、4 个角都是直角的图形是什么？",
      "options": [
        {
          "id": "a",
          "label": "长方形"
        },
        {
          "id": "b",
          "label": "正方形"
        },
        {
          "id": "c",
          "label": "三角形"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "4 条边都相等的是正方形；长方形只有对边相等。"
    },
    {
      "id": "sx-1b-u2-l01-ex2",
