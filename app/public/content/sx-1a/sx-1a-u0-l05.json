  "title": "收获的季节",
  "objectives": ["能按种类给物品分类并计数", "能看出哪一类最多"],
  "blocks": [
    {
      "type": "text",
      "title": "分一分、数一数",
      "content": "秋天收了一堆果实：苹果、梨、柿子混在一起。先按种类分成三堆，再一堆一堆数，最后看哪种最多。"
    },
    {
      "type": "text",
      "title": "分类是为了好数",
      "content": "混着数容易漏，分开数又快又准。分开以后，谁多谁少一眼就看出来了。"
    }
  ],
  "exercises": [
    {
      "id": "sx-1a-u0-l05-ex1",
      "type": "single",
      "stem": "混在一起的东西，先做什么才好数？",
      "options": [
        { "id": "a", "label": "按种类分开" },
        { "id": "b", "label": "直接数" },
        { "id": "c", "label": "随便拿走几个" }
      ],
      "answer": ["a"],
      "explanation": "分开以后每一堆都单纯，数起来不容易错。"
    },
    {
      "id": "sx-1a-u0-l05-ex2",
      "type": "single",
      "stem": "苹果 5 个、梨 3 个、柿子 2 个，哪种最多？",
      "options": [
        { "id": "a", "label": "苹果" },
        { "id": "b", "label": "梨" },
        { "id": "c", "label": "柿子" }
      ],
      "answer": ["a"],
      "explanation": "5 比 3 和 2 都大，苹果最多。"
    },
    {
      "id": "sx-1a-u0-l05-ex3",
      "type": "single",
      "stem": "苹果 5 个、梨 3 个、柿子 2 个，一共多少个？",
      "options": [
        { "id": "a", "label": "10" },
        { "id": "b", "label": "8" },
        { "id": "c", "label": "5" }
      ],
      "answer": ["a"],
      "explanation": "5 + 3 = 8，8 + 2 = 10，一共 10 个。"
    }
  ]
}
