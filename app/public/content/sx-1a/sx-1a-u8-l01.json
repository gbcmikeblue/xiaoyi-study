      "stem": "7 可以分成 3 和几？",
      "options": [
        {
          "id": "a",
          "label": "4"
        },
        {
          "id": "b",
          "label": "3"
        },
        {
          "id": "c",
          "label": "10"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "3 + 4 = 7，所以分成 3 和 4。"
    },
