  "title": "快乐的午餐",
  "objectives": [
    "会用一一对应的方法比多少",
    "能说出“一样多”“多”“少”"
  ],
  "blocks": [
    {
      "type": "image",
      "src": "/content/sx-1a/img/sx-1a-u1-l06.webp",
      "alt": "快乐的午餐的插图"
    },
    {
      "type": "text",
      "title": "一一对应比一比",
      "content": "小动物来吃午餐，一只小兔配一根胡萝卜。配得上的就是一样多；配完还有剩下的，那一方就多；不够配的，那一方就少。"
    },
    {
      "type": "text",
      "title": "举例",
      "content": "4 只小兔、4 根胡萝卜，正好一一配上，一样多。5 个碗、3 只小猫，碗有剩，碗比猫多。"
    }
  ],
  "exercises": [
    {
      "id": "sx-1a-u1-l06-ex1",
      "type": "single",
      "stem": "4 只小兔、4 根胡萝卜，谁多？",
      "options": [
        {
          "id": "a",
          "label": "小兔多"
        },
        {
          "id": "b",
          "label": "胡萝卜多"
        },
        {
          "id": "c",
          "label": "一样多"
        }
      ],
      "answer": [
        "c"
      ],
      "explanation": "一只兔子配一根胡萝卜，正好配完，一样多。"
    },
    {
      "id": "sx-1a-u1-l06-ex2",
      "type": "single",
      "stem": "5 个碗、3 只小猫，碗比猫怎么样？",
      "options": [
        {
          "id": "a",
          "label": "多"
        },
        {
          "id": "b",
          "label": "少"
        },
        {
          "id": "c",
          "label": "一样多"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "3 只小猫各用 1 个碗，还剩 2 个碗，所以碗比猫多。"
    },
    {
      "id": "sx-1a-u1-l06-ex3",
      "type": "single",
      "stem": "3 个苹果分给 5 个小朋友，够不够？",
      "options": [
        {
          "id": "a",
          "label": "够"
        },
        {
          "id": "b",
          "label": "不够"
        },
        {
          "id": "c",
          "label": "正好"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "一人一个需要 5 个，只有 3 个，不够。"
    }
  ]
}
