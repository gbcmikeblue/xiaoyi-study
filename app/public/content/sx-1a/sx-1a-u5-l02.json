  "title": "我说你做",
  "objectives": ["能用方位词描述物体位置", "能按描述摆出正确的图形"],
  "blocks": [
    {
      "type": "text",
      "title": "说清楚位置",
      "content": "“把正方体放在左边，球放在右边，圆柱放在正方体的上面。”——说的人要说全，听的人要照着摆。位置词有：上、下、左、右、前、后、中间。"
    },
    {
      "type": "text",
      "title": "一眼看不出就多问一句",
      "content": "听不明白的时候，别猜，问清楚：“是放在球的左边，还是右边？”"
    }
  ],
  "exercises": [
    {
      "id": "sx-1a-u5-l02-ex1",
      "type": "single",
      "stem": "“球在正方体的上面”，说明球在哪个位置？",
      "options": [
        { "id": "a", "label": "上面" },
        { "id": "b", "label": "下面" },
        { "id": "c", "label": "里面" }
      ],
      "answer": ["a"],
      "explanation": "“在……的上面”，球在上面。"
    },
    {
      "id": "sx-1a-u5-l02-ex2",
      "type": "single",
      "stem": "要描述一个物体的位置，至少要说清什么？",
      "options": [
        { "id": "a", "label": "它和谁比、在哪个方向" },
        { "id": "b", "label": "它的颜色" },
        { "id": "c", "label": "谁的" }
      ],
      "answer": ["a"],
      "explanation": "位置是相对的，要说清参照物和方向。"
    },
    {
      "id": "sx-1a-u5-l02-ex3",
      "type": "multi",
      "stem": "下面哪些是表示位置的词？",
      "options": [
        { "id": "a", "label": "上面" },
        { "id": "b", "label": "左边" },
        { "id": "c", "label": "前面" },
        { "id": "d", "label": "红色" }
      ],
      "answer": ["a", "b", "c"],
      "explanation": "“红色”说的是颜色，不是位置。"
    }
  ]
}
