  "objectives": ["会算 10 的加减法", "记住 10 的分与合"],
  "blocks": [
    {
      "type": "text",
      "title": "10 是一个整数",
      "content": "地里埋着 10 个红薯，挖出 4 个，还剩 6 个：10 - 4 = 6。10 好算，因为它的分与合特别整齐。"
    },
    {
      "type": "text",
      "title": "10 的分与合",
      "content": "1 和 9、2 和 8、3 和 7、4 和 6、5 和 5。这五对要背得滚瓜烂熟，以后学进位加、退位减全靠它。"
    }
  ],
  "exercises": [
