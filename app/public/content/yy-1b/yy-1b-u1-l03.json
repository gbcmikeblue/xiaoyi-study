      "options": [
        { "id": "a", "label": "I like juice." },
        { "id": "b", "label": "I like milk." },
        { "id": "c", "label": "I like tea." }
      ],
      "answer": ["a"],
      "explanation": "听到的是 juice，果汁。"
    },
    {
