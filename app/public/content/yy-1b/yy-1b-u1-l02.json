  "title": "What do you see?",
  "objectives": ["会用 What do you see? 提问", "会用 I see ... 回答"],
  "blocks": [
    {
      "type": "text",
      "title": "问与答",
      "content": "A: What do you see? B: I see a bird. 问“你看见什么”，用 What do you see?"
    },
    {
      "type": "text",
      "title": "多个要说 I see two birds",
      "content": "看见一个说 a bird，看见多个要加 s：I see two birds."
    }
  ],
  "exercises": [
    {
      "id": "yy-1b-u1-l02-ex1",
      "type": "listen",
      "stem": "听一听，选出你听到的句子。",
      "speakText": "I see a bird.",
      "options": [
        { "id": "a", "label": "I see a bird." },
        { "id": "b", "label": "I see a frog." },
        { "id": "c", "label": "I see a bee." }
      ],
      "answer": ["a"],
      "explanation": "听到的是 bird，小鸟。"
    },
    {
      "id": "yy-1b-u1-l02-ex2",
      "type": "single",
      "stem": "问“你看见了什么？”，英语怎么说？",
      "options": [
        { "id": "a", "label": "What do you see?" },
        { "id": "b", "label": "What do you hear?" },
        { "id": "c", "label": "What is this?" }
      ],
      "answer": ["a"],
      "explanation": "看见用 see，听见用 hear。"
    },
    {
      "id": "yy-1b-u1-l02-ex3",
