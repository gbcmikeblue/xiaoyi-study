  "title": "Good morning",
  "objectives": ["会用 Good morning / Good afternoon / Good night 问候", "知道不同时间用不同的问候语"],
  "blocks": [
    {
      "type": "text",
      "title": "按时间打招呼",
      "content": "早上说 Good morning，下午说 Good afternoon，傍晚说 Good evening，睡觉前说 Good night。"
    },
    {
      "type": "text",
      "title": "再见和晚安不一样",
      "content": "Goodbye 是再见；Good night 是晚安，只在晚上分别或睡觉前说。"
    }
  ],
