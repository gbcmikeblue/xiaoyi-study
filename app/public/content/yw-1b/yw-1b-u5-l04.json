  "exercises": [
    {
      "id": "yw-1b-u5-l04-ex1",
      "type": "listen",
      "stem": "听一听，选出你听到的字。",
      "speakText": "初",
      "options": [
        {
          "id": "a",
          "label": "之"
        },
        {
          "id": "b",
          "label": "初"
        },
        {
          "id": "c",
          "label": "善"
