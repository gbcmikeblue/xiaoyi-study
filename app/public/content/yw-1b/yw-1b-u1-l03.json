  "objectives": ["认识“青、蛙、清、晴”四个字", "知道“青”加不同偏旁能变成新字"],
  "blocks": [
    {
      "type": "text",
      "title": "一个字变出好多字",
      "content": "“青”是个很能干的部分：加上三点水，变成“清”，水很干净；加上日字旁，变成“晴”，天上有太阳；加上虫字旁，变成“蜻”，蜻蜓的蜻。"
    },
    {
      "type": "chars",
      "items": [
        { "char": "青", "pinyin": "qīng", "word": "青草" },
        { "char": "蛙", "pinyin": "wā", "word": "青蛙" },
        { "char": "清", "pinyin": "qīng", "word": "清水" },
        { "char": "晴", "pinyin": "qíng", "word": "晴天" }
      ]
    },
    {
      "type": "text",
      "title": "小知识",
      "content": "青蛙小时候叫蝌蚪，长大后会捉害虫，是庄稼的好朋友。"
    }
  ],
