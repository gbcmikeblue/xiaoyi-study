          "word": "国王"
        }
      ]
    }
  ],
  "exercises": [
    {
      "id": "yw-1b-u1-l02-ex1",
      "type": "single",
      "stem": "“李明”这个姓名里，姓是什么？",
      "options": [
        {
          "id": "a",
          "label": "李"
        },
        {
          "id": "b",
          "label": "明"
        },
        {
          "id": "c",
          "label": "李明"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "姓名里前面的是姓，所以“李”是姓，“明”是名。"
    },
