  "title": "I can ...",
  "objectives": ["会用 I can ... 说出自己的能力", "会用 What can you do? 提问"],
  "blocks": [
    {
      "type": "text",
      "title": "I can sing",
      "content": "I can sing. 就是“我会唱歌”。问别人会不会，说：What can you do? 回答：I can dance."
    },
    {
      "type": "text",
      "title": "can 后面跟动词",
      "content": "can 表示“会、能”，后面直接跟动作词，不加 to：I can draw.（不说 I can to draw.）"
    }
  ],
  "exercises": [
    {
      "id": "yy-1a-u4-l02-ex1",
      "type": "listen",
      "stem": "听一听，选出你听到的句子。",
      "speakText": "I can sing.",
      "options": [
        { "id": "a", "label": "I can sing." },
        { "id": "b", "label": "I can dance." },
        { "id": "c", "label": "I can draw." }
      ],
      "answer": ["a"],
      "explanation": "听到的是 sing，不是 dance 或 draw。"
    },
    {
