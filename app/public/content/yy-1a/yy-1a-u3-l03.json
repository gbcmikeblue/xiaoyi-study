  "title": "In my schoolbag",
  "objectives": ["会用 I have ... 说出自己有什么", "能用复数说出多个物品"],
  "blocks": [
    {
      "type": "text",
      "title": "I have a book",
      "content": "I have a book. I have two pencils. 说自己有什么，用 I have ...。"
    },
    {
      "type": "text",
      "title": "一个和多个",
      "content": "一个说 a pencil，两个以上说 two pencils，名词要加 s。"
    }
  ],
  "exercises": [
    {
      "id": "yy-1a-u3-l03-ex1",
      "type": "listen",
      "stem": "听一听，选出你听到的句子。",
      "speakText": "I have a book.",
      "options": [
        { "id": "a", "label": "I have a book." },
        { "id": "b", "label": "I have a bag." },
        { "id": "c", "label": "I have a ruler." }
      ],
      "answer": ["a"],
      "explanation": "听到的是 book，书。"
    },
    {
      "id": "yy-1a-u3-l03-ex2",
      "type": "single",
      "stem": "“我有两把尺子”用英语怎么说？",
      "options": [
        { "id": "a", "label": "I have two rulers." },
        { "id": "b", "label": "I have two ruler." },
        { "id": "c", "label": "I has two rulers." }
      ],
      "answer": ["a"],
      "explanation": "两个以上，ruler 要加 s。"
    },
    {
      "id": "yy-1a-u3-l03-ex3",
      "type": "single",
      "stem": "说“我有一个书包”，该用哪个动词？",
      "options": [
        { "id": "a", "label": "have" },
        { "id": "b", "label": "has" },
        { "id": "c", "label": "is" }
      ],
      "answer": ["a"],
      "explanation": "主语是 I，用 have；has 用于 he / she。"
    }
  ]
